# Copy to .env.local and replace placeholders locally. Never commit real keys.
# Target: Base Sepolia (84532), mock hUSDC. No mainnet credentials.
RPC_URL=https://sepolia.base.org
OPERATOR_PRIVATE_KEY=
TOKEN_ADDRESS=
ESCROW_ADDRESS=
# Must equal ESCROW_ADDRESS; embedded into the client at build time.
NEXT_PUBLIC_ESCROW_ADDRESS=
APP_URL=http://localhost:3000
DB_PATH=./data/headcount.db
# Optional contract verification key (used by the Foundry task pack).
ETHERSCAN_KEY=
