# Isolated Headcount vhost for the existing Nginx on rhm-server-eu.
# Add as a separate site; preserve every existing site (including n8n).
# Enable this OR nginx-http.conf.example, never both for this server_name.
# Certificate paths below are intended locations, not provisioned certificates.
# Obtain a certificate or substitute verified paths whose SAN covers this domain
# before enabling this file. Validate the full Nginx configuration before reload.
server {
    listen 80;
    listen [::]:80;
    server_name headcount.zymo.qzz.io;

    # Keep the HTTP challenge route available for certificate renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/headcount-acme;
        try_files $uri =404;
    }

    location / {
        return 308 https://headcount.zymo.qzz.io$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name headcount.zymo.qzz.io;

    ssl_certificate /etc/letsencrypt/live/headcount.zymo.qzz.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/headcount.zymo.qzz.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        # Receipt-backed mutations can wait behind the operator's serial queue.
        # A timeout still means an uncertain result; inspect before retrying.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
